# Godot 4+ specific ignores
.godot/

# Backups locais comprimidos (o Git e o historico canonico)
.backup/

# Artefatos de build de utilitarios externos (PyInstaller)
externo/**/build/
externo/**/dist/

# Estado de usuario (overrides de configuracao)
config_usuario.json

# ============================================================================
# Dados pessoais e externos — NAO versionar (protecao LGPD)
# ============================================================================
# dados/: dados importados pelo usuario (hist.csv, email.csv, planejamento.csv,
# horarios.txt, preferencias de horario...). Contem dados pessoais de alunos e
# professores. Mantemos a pasta e o marcador .gdignore; ignoramos o conteudo.
/dados/*
!/dados/.gdignore

# Tokens de participantes do LimeSurvey (gerados; vinculam-se a alunos).
arquivos/limesurvey/survey_tokens.lst

# arquivos/oferta/: DADOS PESSOAIS de docentes (historico_professores.json, lista_professores.json)
# e o prompt que os gera. O repositorio e publico; esta pasta vem inteira do alec-data (privado),
# trazida por ferramentas/sincronizar_dados_curso.ps1, e NUNCA e commitada aqui.
# O programa funciona sem ela (main.gd checa a existencia antes de ler); o Planejamento de Oferta
# apenas deixa de sugerir professores e de calcular afinidade.
# Mantemos a pasta e o marcador .gdignore versionados, como em dados/.
/arquivos/oferta/*
!/arquivos/oferta/.gdignore

# ============================================================================
# Saidas geradas pelo programa (regeneraveis — o programa recria a pasta)
# ============================================================================
/exportacoes/

# ============================================================================
# Lixo de sistema operacional / OneDrive
# ============================================================================
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store
~$*
*.tmp

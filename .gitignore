# Godot 4+ specific ignores
.godot/

# Backups locais comprimidos (o Git e o historico canonico)
.backup/

# Artefatos de build de utilitarios externos (PyInstaller)
externo/**/build/
externo/**/dist/

# Estado de usuario (overrides de configuracao)
config_usuario.json

# ============================================================================
# Dados pessoais e externos — NAO versionar (protecao LGPD)
# ============================================================================
# dados/: dados importados pelo usuario (hist.csv, email.csv, planejamento.csv,
# horarios.txt, preferencias de horario...). Contem dados pessoais de alunos e
# professores. Mantemos a pasta e o marcador .gdignore; ignoramos o conteudo.
/dados/*
!/dados/.gdignore

# Tokens de participantes do LimeSurvey (gerados; vinculam-se a alunos).
arquivos/limesurvey/survey_tokens.lst

# Dados nominais de docentes. Ficam em arquivos/ por conveniencia (o programa os le de la), mas sao
# DADOS PESSOAIS e o repositorio e publico — cada instalacao monta os seus. O programa funciona sem
# eles (main.gd checa a existencia antes de ler); o modulo Planejamento de Oferta apenas deixa de
# sugerir professores e de calcular afinidade.
#   historico_professores.json: 95 docentes com disciplina, ano, semestre, dia e horario de cada aula
#   lista_professores.json:     docentes do curso, nome a nome
arquivos/oferta/historico_professores.json
arquivos/lista_professores.json

# ============================================================================
# Saidas geradas pelo programa (regeneraveis — o programa recria a pasta)
# ============================================================================
/exportacoes/

# ============================================================================
# Lixo de sistema operacional / OneDrive
# ============================================================================
desktop.ini
Thumbs.db
ehthumbs.db
.DS_Store
~$*
*.tmp
